# Never put production credentials into this example or Git.
# Only used by: cargo run --release -- serve config.live.json --live
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# 0 = EOA; 1 = proxy; 2 = Safe. Deposit wallet type 3 is out of scope.
POLY_SIGNATURE_TYPE=2
POLY_FUNDER=
# Protects the local signal, order-status and stop endpoints. At least 32 bytes.
DEMO_ACCESS_TOKEN=
