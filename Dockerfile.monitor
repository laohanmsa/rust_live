FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 --no-create-home monitor
WORKDIR /app
COPY scripts/monitor.py scripts/monitor.py
COPY tests/test_monitor.py tests/test_monitor.py
RUN python3 -m unittest discover -s tests -p test_monitor.py
ENTRYPOINT ["python3", "-u", "/app/scripts/monitor.py"]
